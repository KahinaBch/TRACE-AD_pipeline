manifest {
    name            = 'TRACE-AD local ancestry'
    description     = 'FLARE global/local ancestry at protein-associated variants, from a cohort VCF'
    mainScript      = 'main.nf'
    nextflowVersion = '>=24.04.0'
}

params {
    help        = false          // --help: print usage and exit

    // ---- main run --------------------------------------------------------
    mode        = 'run'          // run | plink_to_vcf | fix_strands
    vcf         = null           // cohort genotypes, bgzipped VCF (GRCh38)
    cohort      = null           // used only to name outputs
    protein     = null           // must match a protein in assets/targets.csv
    outdir      = '.'            // results_<cohort>_<protein>/ is created here

    // ---- references --------------------------------------------------------
    // Downloaded on first use into ref_dir and reused afterwards. Teams whose
    // compute nodes have no internet can pre-fill ref_dir themselves.
    ref_dir     = "${launchDir}/trace_ad_references"
    panel_url   = 'https://github.com/KahinaBch/TRACE-AD_pipeline/releases/download/ref-phased-chr{chr}-v1/ref_{chr}_phased.vcf.gz'
    beagle_jar  = 'https://github.com/KahinaBch/TRACE-AD_pipeline/releases/download/beagle-v5.2-28Jun21.220/beagle.28Jun21.220.jar'
    flare_jar   = 'https://github.com/KahinaBch/TRACE-AD_pipeline/releases/download/flare-v0.6.0/flare.jar'
    targets     = "${projectDir}/assets/targets.csv"
    sample_map  = "${projectDir}/assets/b38_sample_map.txt"
    contigs     = "${projectDir}/assets/contigs.txt"
    genetic_map = "${projectDir}/assets/genetic_maps/chr{chr}.GRCh38.map"
    supported_chroms = '2,6,19'  // chromosomes with a published phased panel

    // ---- behaviour ---------------------------------------------------------
    ignore_flips       = false   // continue even if the sanity check finds strand flips
    max_proxy_distance = 20000   // bp; furthest FLARE marker accepted as a proxy for a target

    // ---- helper modes ------------------------------------------------------
    bfile = null                 // plink_to_vcf: plink prefix (path without .bed/.bim/.fam)
    chrom = null                 // plink_to_vcf: optional, export one chromosome only
    out   = null                 // helper output file name

    // ---- resources (same values as the per-cohort jobs) --------------------
    threads       = 8
    beagle_mem_gb = 24
    flare_mem_gb  = 48
}

process {
    errorStrategy = 'terminate'

    withLabel: bcftools { container = 'quay.io/biocontainers/bcftools:1.22--h3a4d415_1' }
    withLabel: python   { container = 'quay.io/biocontainers/pysam:0.24.1--py312hf5ad864_0' }
    withLabel: java     { container = 'eclipse-temurin:21-jre' }
    withLabel: plink2   { container = 'quay.io/biocontainers/plink2:2.00a3.7--h4ac6f70_4' }

    withName: 'INDEX_VCF|INDEX_EXPORT|INDEX_PANEL' { cpus = 2;              memory = '4 GB';  time = '4h'  }
    withName: SANITY_CHECK            { cpus = 1;              memory = '4 GB';  time = '6h'  }
    withName: PREPARE                 { cpus = params.threads as int; memory = '16 GB'; time = '12h' }
    withName: PHASE                   { cpus = params.threads as int; memory = { "${((params.beagle_mem_gb as int) * 13).intdiv(10) + 2} GB" }; time = '48h' }
    withName: CHECK_PHASED            { cpus = 1;              memory = '4 GB';  time = '12h' }
    withName: FLARE                   { cpus = params.threads as int; memory = { "${((params.flare_mem_gb as int) * 13).intdiv(10) + 2} GB" }; time = '48h' }
    withName: 'EXTRACT_LOCAL|REPORT'  { cpus = 1;              memory = '4 GB';  time = '2h'  }
    withName: FIX_STRANDS             { cpus = 1;              memory = '4 GB';  time = '12h' }
    withName: PLINK_TO_VCF            { cpus = params.threads as int; memory = '32 GB'; time = '12h' }

    // Helper output (plink_to_vcf) goes to outdir
    withName: INDEX_EXPORT { publishDir = [path: { params.outdir }, mode: 'copy'] }

    // Final deliverables go to results_<cohort>_<protein>/
    withName: 'SANITY_CHECK|FLARE|EXTRACT_LOCAL|REPORT' {
        publishDir = [
            path: { "${params.outdir}/results_${params.cohort}_${params.protein}" },
            mode: 'copy',
            saveAs: { f -> f ==~ /.*\.(global\.anc\.gz|model|local_ancestry\.tsv|txt)$/ ? f : null }
        ]
    }
}

profiles {
    // where jobs run: the current machine, or your cluster's scheduler
    local  { process.executor = 'local' }
    slurm  { process.executor = 'slurm' }    // sbatch
    pbspro { process.executor = 'pbspro' }   // qsub, PBS Professional
    pbs    { process.executor = 'pbs' }      // qsub, PBS/Torque
    sge    { process.executor = 'sge' }      // qsub, Sun/Univa Grid Engine (multi-CPU steps need process.penv, see the wiki)
    lsf    { process.executor = 'lsf' }      // bsub
    condor { process.executor = 'condor' }   // condor_submit

    // which container engine runs the tools
    apptainer   { apptainer.enabled = true;   apptainer.autoMounts = true }
    singularity { singularity.enabled = true; singularity.autoMounts = true }
    docker      { docker.enabled = true;      docker.runOptions = '-u $(id -u):$(id -g)' }

    // installation test on synthetic data shipped in tests/data (no input files needed):
    //   nextflow run <pipeline> -profile test,docker   (or test,apptainer / test,singularity)
    test {
        params.vcf           = "${projectDir}/tests/data/test_cohort.vcf.gz"
        params.cohort        = 'TEST'
        params.protein       = 'APOE'
        params.ref_dir       = "${projectDir}/tests/data"
        params.sample_map    = "${projectDir}/tests/data/test_sample_map.txt"
        params.outdir        = "${launchDir}/pipeline_test"
        params.threads       = 2
        params.beagle_mem_gb = 2
        params.flare_mem_gb  = 2
        process.resourceLimits = [cpus: 2, memory: '6 GB', time: '1h']
    }

    // ready-made combination for SURF Snellius (SLURM partition 'genoa' + Apptainer)
    snellius {
        process.executor  = 'slurm'
        process.queue     = 'genoa'
        apptainer.enabled = true
        apptainer.autoMounts = true
    }
}
